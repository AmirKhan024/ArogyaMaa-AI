# ArogyaMaa-AI Environment Configuration
# Copy this file to .env and fill in your actual values.
# External services after the transformation: Supabase (free) + Groq (free) ONLY.

# ── Flask ──────────────────────────────────────────────
SECRET_KEY=            # REQUIRED. Generate: python -c "import secrets;print(secrets.token_hex(32))"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ── Supabase (Postgres) ────────────────────────────────
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> "URI".
# Use the connection POOLER URI (port 6543) for app runtime, and the "psycopg" driver.
# Example: postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres
# For local dev you may instead point this at a local Postgres:
#   postgresql+psycopg://postgres:postgres@localhost:5432/arogyamaa
DATABASE_URL=

# ── Groq (LLM + Whisper STT) — FREE tier, the ONLY AI key you need ──
GROQ_API_KEY=
# NOTE: openai/gpt-oss-* are OPEN-WEIGHTS models HOSTED BY GROQ. Using them needs only
# GROQ_API_KEY — NOT an OpenAI account. Verify a current id at console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=llama-3.1-8b-instant
WHISPER_MODEL=whisper-large-v3

# ── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
APPOINTMENT_WEBHOOK_PORT=5050

# ── Internal service auth (bot -> API) ─────────────────
# Generate a random hex; used for server-to-server calls from the bot to guarded API routes.
INTERNAL_API_TOKEN=

# ── Dev-only static admin login (optional) ─────────────
# There is no admins table in this prototype. For local demos you may enable a static
# admin login (active ONLY when APP_ENV=development). Leave ADMIN_PASSWORD blank to disable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Optional: LangSmith tracing (free tier) ────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ArogyaMaa
LANGCHAIN_TRACING_V2=false

# ── Feature flags ──────────────────────────────────────
ENABLE_AI_ADVISORY=True
